# Loops.so API key – get yours at https://app.loops.so/settings?page=api
# Copy this file to .env and fill in the value
VITE_LOOPS_API_KEY=your_loops_api_key_here

# The Loops mailing list ID to subscribe users to (optional)
# Found in Loops → Audience → Lists
VITE_LOOPS_LIST_ID=

# Default platform arbiter public key (Solana address).
# This pre-fills the arbiter field when clients create a job.
# Set to your trusted multisig, DAO, or platform wallet.
# If left blank, clients must enter an arbiter address manually.
VITE_DEFAULT_ARBITER=

# A pool of trusted arbiter public keys (comma-separated).
# If provided, clients can randomly select an arbiter from this pool.
VITE_ARBITER_POOL=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA,ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL,SysvarRent111111111111111111111111111111111
